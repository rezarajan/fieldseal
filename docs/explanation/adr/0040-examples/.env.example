# One deploy's configuration (twelve-factor III): each value once, read by every process that
# needs it. `fieldseal config` lists each service's variables with type, default and whether it
# is required; every service checks its own at start-up and refuses to run on an unknown
# FIELDSEAL_* variable or a missing, empty or malformed value. One value per variable: no
# lists packed into strings, no query parameters carrying settings.
FIELDSEAL_TIER=development                        # development | production (ADR 0038 floors)
FIELDSEAL_FACTORY_URL=http://localhost:8080       # read by the factory (its public URL), the CLI,
FIELDSEAL_INTAKE_URL=http://localhost:8480        #   the web app and device provisioning: one copy
FIELDSEAL_LOG_URL=http://localhost:9001
FIELDSEAL_OIDC_ISSUER=http://localhost:8180/realms/fieldseal
FIELDSEAL_OIDC_CLIENT_ID=fieldseal-factory
FIELDSEAL_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client   # secrets by file or platform store, never inline
FIELDSEAL_OIDC_ACR_VALUES=phr
FIELDSEAL_KEYS=file:///authority/online           # the URI scheme selects the adapter: file: (development
                                                  #   only), pkcs11:, awskms:, gcpkms:, azurekv:
FIELDSEAL_STATE=file:///state                     # file: (development only) | postgres://…
PORT=8080                                         # each process binds $PORT (factor VII)
