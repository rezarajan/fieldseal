            fieldset.q diet.weighed.extras.water.yesterday
          article.card diet.weighed.extras.other
            div.q diet.weighed.extras.other.other
            fieldset.q diet.weighed.extras.other.freq
            div.q diet.weighed.extras.other.amount
            fieldset.q diet.weighed.extras.other.yesterday
  div.display thanks
